# Copy to .env for local development:  cp .env.example .env

# --- AI (Anthropic) ---
# Your Anthropic API key. Get one at https://console.anthropic.com
# If left blank, Reelmint runs in a built-in DEMO mode with realistic,
# topic-aware sample content (no real AI calls, still fully clickable).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
# Optional: a separate model for vision (scan). Defaults to AI_MODEL.
AI_VISION_MODEL=
# Sampling temperature for creative writing (0–1) and structured JSON (0–1).
AI_TEMPERATURE=0.8
AI_JSON_TEMPERATURE=0.4

# --- Server ---
PORT=3000
# Storage: set DATABASE_URL to use Postgres (durable, multi-instance).
# Leave it blank to use a local JSON file at DATA_DIR (fine for local/demo).
DATABASE_URL=
# Set to "disable" for a local Postgres without SSL (default uses SSL when DATABASE_URL is set).
PGSSL=
# Where the JSON store is written when DATABASE_URL is not set.
DATA_DIR=./.data
# Secret used to sign login tokens. REQUIRED in production — set a long random value.
AUTH_SECRET=
# Set to 1 to disable the free-tier watermark everywhere.
REELMINT_NO_WATERMARK=

# --- Photoreal image generation (optional) ---
# Option A: OpenAI Images API
IMAGE_PROVIDER=            # set to "openai" to enable
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1
# Option B: any custom endpoint that takes {prompt,width,height} -> {url} or {b64}
IMAGE_API_URL=
IMAGE_API_KEY=

# --- Billing (Stripe, optional) ---
# Create products/prices in the Stripe dashboard, then paste the price IDs.
STRIPE_SECRET_KEY=
# Recurring subscription prices:
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
# One-time credit packs (à-la-carte revenue). Create one-time Prices for each.
STRIPE_PRICE_PACK50=
STRIPE_PRICE_PACK200=
STRIPE_PRICE_PACK500=
# From `stripe listen` (local) or the webhook endpoint settings (prod).
STRIPE_WEBHOOK_SECRET=

# --- Growth ---
# Credits granted to BOTH sides when a referral converts (default 10).
REFERRAL_BONUS=10

# --- Security / abuse limits ---
# CORS is closed by default (same-origin). Set a comma-separated allowlist to let
# named origins call the API, e.g. a separate marketing domain.
CORS_ORIGIN=
# Per-IP rate limits. Defaults: 30 AI calls/min, 20 auth attempts/15 min.
# Raise on a busy deploy; counts are per process, so several instances multiply them.
RATE_LIMIT_AI_MAX=
RATE_LIMIT_AI_WINDOW_MS=
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_AUTH_WINDOW_MS=
