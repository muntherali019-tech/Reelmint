{
  "name": "reelmint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reelmint — AI studio that mints short & long videos, images and copy from a single prompt, with a voice/text AI editor.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test test/**/*.test.js",
    "test:watch": "node --watch --test test/**/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/**/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "express": "^4.21.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
