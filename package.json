{
  "name": "reelmint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reelmint — AI studio that mints short & long videos, images and copy from a single prompt, with a voice/text AI editor.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "test:watch": "node --watch --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.1",
    "express": "^4.21.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
